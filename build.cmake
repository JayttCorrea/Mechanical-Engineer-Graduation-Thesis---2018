# Portable build entry point: cmake -P build.cmake
cmake_minimum_required(VERSION 3.21)
set(root "${CMAKE_CURRENT_LIST_DIR}")
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    set(platform mac)
elseif(CMAKE_HOST_WIN32)
    set(platform windows)
else()
    string(TOLOWER "${CMAKE_HOST_SYSTEM_NAME}" platform)
endif()
if(NOT DEFINED TCC_BUILD_DIR)
    set(TCC_BUILD_DIR "${root}/build-${platform}")
endif()
if(NOT DEFINED TCC_INSTALL_DIR)
    set(TCC_INSTALL_DIR "${root}/dist/${platform}")
endif()
get_filename_component(TCC_BUILD_DIR "${TCC_BUILD_DIR}" ABSOLUTE)
get_filename_component(TCC_INSTALL_DIR "${TCC_INSTALL_DIR}" ABSOLUTE)
set(options)
foreach(option TCC_BUILD_GPU TCC_BUILD_VIEWER TCC_BUILD_TESTS TCC_OPENMP TCC_STATIC_RUNTIME TCC_MACOS_IPO)
    if(DEFINED ${option})
        list(APPEND options "-D${option}=${${option}}")
    endif()
endforeach()
# Respect existing generators; otherwise prefer Ninja if it is installed.
if(NOT EXISTS "${TCC_BUILD_DIR}/CMakeCache.txt" AND "$ENV{CMAKE_GENERATOR}" STREQUAL "")
    find_program(ninja NAMES ninja ninja-build)
    if(ninja)
        list(APPEND options -G Ninja)
    endif()
endif()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Build step failed (${result}): ${ARGV}")
    endif()
endfunction()
message(STATUS "Automatic build: ${platform}; output: ${TCC_INSTALL_DIR}")
run("${CMAKE_COMMAND}" -S "${root}" -B "${TCC_BUILD_DIR}" -DCMAKE_BUILD_TYPE=Release ${options})
run("${CMAKE_COMMAND}" --build "${TCC_BUILD_DIR}" --config Release --parallel)
# Honor the configured cache, including when an existing build disabled tests.
file(STRINGS "${TCC_BUILD_DIR}/CMakeCache.txt" tests REGEX "^TCC_BUILD_TESTS:BOOL=ON$")
if(tests)
    find_program(ctest NAMES ctest REQUIRED)
    run("${ctest}" --test-dir "${TCC_BUILD_DIR}" -C Release --output-on-failure)
endif()
run("${CMAKE_COMMAND}" --install "${TCC_BUILD_DIR}" --config Release --prefix "${TCC_INSTALL_DIR}")
if(platform STREQUAL "mac" AND EXISTS "${TCC_INSTALL_DIR}/fluid_viewer.app")
    find_program(codesign NAMES codesign REQUIRED)
    run("${codesign}" --force --sign - "${TCC_INSTALL_DIR}/fluid_viewer.app")
    run("${codesign}" --verify --deep --strict "${TCC_INSTALL_DIR}/fluid_viewer.app")
endif()
message(STATUS "Build, tests and installation complete: ${TCC_INSTALL_DIR}")
